{
  "note": "Probes beside ../probes.json that matter for the Postgres validators: how the schema text and the instance text are read (duplicate keys, depth, surrogates, numbers), and the string and number rules a type could lean on.",
  "probes": [
    { "id": "x1", "note": "a duplicate key in the schema text, string then integer, a string", "schema_text": "{\"type\": \"string\", \"type\": \"integer\"}", "instance": "a" },
    { "id": "x2", "note": "a duplicate key in the schema text, integer then string, a string", "schema_text": "{\"type\": \"integer\", \"type\": \"string\"}", "instance": "a" },
    {"id": "x3", "note": "an instance nested 200 arrays deep, schema true", "schema": true, "instance_text": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"},
    {"id": "x4", "note": "an instance nested 200 arrays deep, type array", "schema": {"type": "array"}, "instance_text": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"},
    { "id": "x5", "note": "a lone surrogate escape in a string, type string", "schema": { "type": "string" }, "instance_text": "\"\\ud800\"" },
    { "id": "x6", "note": "the escape \\u0000 in a string, type string", "schema": { "type": "string" }, "instance_text": "\"a\\u0000b\"" },
    { "id": "x7", "note": "integer, written with an exponent (1e2)", "schema": { "type": "integer" }, "instance_text": "1e2" },
    { "id": "x8", "note": "integer, 1.5e1", "schema": { "type": "integer" }, "instance_text": "1.5e1" },
    { "id": "x9", "note": "integer, a long zero fraction (1.000000000000000000001 is not an integer)", "schema": { "type": "integer" }, "instance_text": "1.000000000000000000001" },
    { "id": "x10", "note": "maximum 9007199254740992, the next integer up", "schema": { "type": "integer", "maximum": 9007199254740992 }, "instance_text": "9007199254740993" },
    { "id": "x11", "note": "multipleOf 0.01, the value 0.07", "schema": { "multipleOf": 0.01 }, "instance_text": "0.07" },
    { "id": "x12", "note": "maxLength 1, an emoji outside the BMP (one code point, two UTF-16 units)", "schema": { "type": "string", "maxLength": 1 }, "instance": "😀" },
    { "id": "x13", "note": "maxLength 1, e and a combining accent (two code points)", "schema": { "type": "string", "maxLength": 1 }, "instance_text": "\"e\\u0301\"" },
    { "id": "x14", "note": "pattern ^\\d$, an Arabic-Indic digit", "schema": { "type": "string", "pattern": "^\\d$" }, "instance": "٣" },
    { "id": "x15", "note": "pattern a, matched anywhere (no anchor)", "schema": { "type": "string", "pattern": "a" }, "instance": "xax" },
    { "id": "x16", "note": "uniqueItems, 1 and 1.0", "schema": { "uniqueItems": true }, "instance_text": "[1, 1.0]" },
    { "id": "x17", "note": "$schema inside a subschema, not the root (the root has none)", "schema": { "properties": { "a": { "$schema": "http://json-schema.org/draft-04/schema#", "maximum": 5, "exclusiveMaximum": true } } }, "instance": { "a": 5 } },
    { "id": "x18", "note": "$schema not a string", "schema": { "$schema": 5, "type": "string" }, "instance": 1 },
    { "id": "x19", "note": "format date, a non-date", "schema": { "type": "string", "format": "date" }, "instance": "nope" },
    { "id": "x20", "note": "an unknown format name", "schema": { "type": "string", "format": "nope" }, "instance": "a" },
    { "id": "x21", "note": "type integer with enum of strings, a string", "schema": { "type": "integer", "enum": ["a"] }, "instance": "a" },
    { "id": "x22", "note": "the empty object schema, any value", "schema": {}, "instance": { "a": [1, null] } },
    { "id": "x23", "note": "properties with a key that holds a slash and a tilde", "schema": { "type": "object", "properties": { "a/b~c": { "type": "string" } } }, "instance": { "a/b~c": 1 } },
    { "id": "x24", "note": "a non-ASCII key and a unicode escape in the schema", "schema_text": "{\"type\": \"object\", \"properties\": {\"\\u00e9\": {\"type\": \"string\"}}}", "instance": { "é": 1 } },
    { "id": "x25", "note": "required, a key present with null", "schema": { "type": "object", "required": ["a"] }, "instance": { "a": null } },
    { "id": "x26", "note": "a big integer against maximum 1", "schema": { "maximum": 1 }, "instance_text": "123456789012345678901234567890" },
    { "id": "x27", "note": "1e400 against maximum 1", "schema": { "maximum": 1 }, "instance_text": "1e400" },
    { "id": "x28", "note": "a huge multipleOf exponent in the schema", "schema": { "multipleOf": 1e-400 }, "schema_text": "{\"multipleOf\": 1e-400}", "instance": 1 },
    { "id": "x29", "note": "$ref to a file URL", "schema": { "$ref": "file:///etc/hosts" }, "instance": 1 },
    { "id": "x30", "note": "$id at the root beside a relative $ref", "schema": { "$id": "http://x.test/root", "$defs": { "s": { "type": "string" } }, "$ref": "#/$defs/s" }, "instance": 1 },
    {"id": "x31", "note": "$schema draft-04 written without the trailing #, draft 4's boolean exclusiveMaximum", "schema": {"$schema": "http://json-schema.org/draft-04/schema", "maximum": 5, "exclusiveMaximum": true}, "instance": 5},
    {"id": "x32", "note": "$schema draft-07 written without the trailing #, if/then", "schema": {"$schema": "http://json-schema.org/draft-07/schema", "if": {"type": "string"}, "then": {"minLength": 2}}, "instance": "a"},
    {"id": "x33", "note": "$schema 2020-12 written with a trailing #, prefixItems", "schema": {"$schema": "https://json-schema.org/draft/2020-12/schema#", "prefixItems": [{"type": "string"}]}, "instance": [1]},
    {"id": "x34", "note": "$schema draft-07 over https, if/then", "schema": {"$schema": "https://json-schema.org/draft-07/schema#", "if": {"type": "string"}, "then": {"minLength": 2}}, "instance": "a"},
    {"id": "x35", "note": "$schema the unversioned http://json-schema.org/schema#, prefixItems", "schema": {"$schema": "http://json-schema.org/schema#", "prefixItems": [{"type": "string"}]}, "instance": [1]},
    {"id": "x36", "note": "$schema 2019-09 written with a trailing #, dependentRequired", "schema": {"$schema": "https://json-schema.org/draft/2019-09/schema#", "dependentRequired": {"a": ["b"]}}, "instance": {"a": 1}}
  ]
}
