datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  guest
}

model Account {
  id      String  @id @default(uuid()) @db.Uuid
  email   String  @unique @db.VarChar(255)
  role    Role    @default(user)
  balance Decimal @default(0) @db.Decimal(12, 2)
}
