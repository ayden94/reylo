{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "contentMappers": [
    {
      "package": "reylo",
      "extensions": [".sql"]
    }
  ],
  "include": ["src"],
  "exclude": ["node_modules"]
}
