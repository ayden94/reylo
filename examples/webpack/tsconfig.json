{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "contentMappers": [{ "package": "reylo", "extensions": [".sql"] }],
  "include": ["src", "queries", "setup.ts"]
}
