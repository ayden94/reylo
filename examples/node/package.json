{
  "name": "reylo-example-node",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node --env-file-if-exists=.env setup.ts",
    "typecheck": "tsc --noEmit --runExternalCode",
    "start": "node --env-file-if-exists=.env --import reylo/register src/main.ts",
    "test": "node --env-file-if-exists=.env --import reylo/register --test"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "reylo": "link:../../dist/reylo"
  },
  "devDependencies": {
    "@reylosql/postgres": "link:../../dist/postgres",
    "@types/node": "^26.6.1",
    "typescript": "7.1.0-beta"
  }
}
