-serde_json = "1.0.82"
-thiserror = "1.0.31"
-
-[build-dependencies]
-bindgen = "0.66.1"
-clippy = { version = "0.0.302", optional = true }
-prost-build = "0.13.5"
-fs_extra = "1.2.0"
-cc = "1.0.83"
-glob = "0.3.1"
-
-[dev-dependencies]
-brunch = "0.11"
-easy-parallel = "3.2.0"
-pretty_assertions = "1.4.0"
-regex = "1.6.0"
-
-[[bench]]
-name = "parse_vs_summary"
-harness = false
-
-[[bench]]
-name = "parse_very_large_query"
-harness = false
