+++ engine-lab/pg_query-vendored/build.rs	2026-09-18 15:10:55
@@ -73,6 +73,17 @@
         .map_err(|_| "Unable to generate bindings")?
         .write_to_file(out_dir.join("bindings.rs"))?;
 
+    // wasm32 workaround: bindgen emits no `extern "C"` functions for wasm targets
+    // (rust-lang/rust-bindgen#1941). Append the block captured from a native build.
+    if target.starts_with("wasm32") {
+        let bindings = std::fs::read_to_string(out_dir.join("bindings.rs"))?;
+        if !bindings.contains("extern \"C\"") {
+            let block = std::fs::read_to_string(Path::new(env!("CARGO_MANIFEST_DIR")).join("extern_block.rs"))?;
+            std::fs::write(out_dir.join("bindings.rs"), format!("{bindings}\n{block}"))?;
+            println!("cargo:warning=injected extern block for wasm32");
+        }
+    }
+
     // Only generate protobuf bindings if protoc is available
     let protoc_exists = Command::new("protoc").arg("--version").status().is_ok();
     // If the package is being built by docs.rs, we don't want to regenerate the protobuf bindings
