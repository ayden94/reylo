{
  "drafts": {
    "none": null,
    "draft4": "http://json-schema.org/draft-04/schema#",
    "draft6": "http://json-schema.org/draft-06/schema#",
    "draft7": "http://json-schema.org/draft-07/schema#",
    "draft2019": "https://json-schema.org/draft/2019-09/schema",
    "draft2020": "https://json-schema.org/draft/2020-12/schema",
    "unknown": "http://example.com/unknown-meta-schema"
  },
  "probes": [
    { "id": "t1", "note": "type string, a string", "schema": { "type": "string" }, "instance": "a" },
    { "id": "t2", "note": "type string, a number", "schema": { "type": "string" }, "instance": 1 },
    { "id": "t3", "note": "integer with a zero fraction", "schema": { "type": "integer" }, "instance": 1.0, "instance_text": "1.0" },
    { "id": "t4", "note": "integer, a fraction", "schema": { "type": "integer" }, "instance": 1.5 },
    { "id": "t5", "note": "type list with null", "schema": { "type": ["string", "null"] }, "instance": null },
    { "id": "t6", "note": "object, an array", "schema": { "type": "object" }, "instance": [] },
    { "id": "t7", "note": "array, an object", "schema": { "type": "array" }, "instance": {} },
    { "id": "t8", "note": "number, a numeric string", "schema": { "type": "number" }, "instance": "1" },
    { "id": "t9", "note": "integer, an integer above 2^64", "schema": { "type": "integer" }, "instance_text": "123456789012345678901234567890" },
    { "id": "t10", "note": "number, an exponent beyond a double", "schema": { "type": "number" }, "instance_text": "1e400" },
    { "id": "t11", "note": "type null, JSON null", "schema": { "type": "null" }, "instance": null },
    { "id": "t12", "note": "type string, JSON null", "schema": { "type": "string" }, "instance": null },

    { "id": "e1", "note": "enum, a value outside it", "schema": { "enum": ["a", "b"] }, "instance": "c" },
    { "id": "e2", "note": "const, another value", "schema": { "const": "a" }, "instance": "b" },
    { "id": "e3", "note": "const 1, the value 1.0", "schema": { "const": 1 }, "instance": 1.0, "instance_text": "1.0" },
    { "id": "e4", "note": "enum [1], the value 1.0", "schema": { "enum": [1] }, "instance": 1.0, "instance_text": "1.0" },
    { "id": "e5", "note": "enum of an object, a wider object", "schema": { "enum": [{ "a": 1 }] }, "instance": { "a": 1, "b": 2 } },
    { "id": "e6", "note": "enum with null, null", "schema": { "enum": ["a", null] }, "instance": null },
    { "id": "e7", "note": "enum of an array, another array order", "schema": { "enum": [[1, 2]] }, "instance": [2, 1] },

    { "id": "o1", "note": "required, an empty object", "schema": { "type": "object", "required": ["a"] }, "instance": {} },
    { "id": "o2", "note": "property type", "schema": { "type": "object", "properties": { "a": { "type": "string" } } }, "instance": { "a": 1 } },
    { "id": "o3", "note": "additionalProperties false, an extra key", "schema": { "type": "object", "properties": { "a": { "type": "string" } }, "additionalProperties": false }, "instance": { "a": "x", "b": 1 } },
    { "id": "o4", "note": "additionalProperties a schema, a wrong extra value", "schema": { "type": "object", "additionalProperties": { "type": "string" } }, "instance": { "b": 1 } },
    { "id": "o5", "note": "patternProperties beside additionalProperties false, a key the pattern takes", "schema": { "type": "object", "patternProperties": { "^x": { "type": "string" } }, "additionalProperties": false }, "instance": { "xa": "s" } },
    { "id": "o6", "note": "patternProperties, a wrong value under the pattern", "schema": { "type": "object", "patternProperties": { "^x": { "type": "string" } } }, "instance": { "xa": 1 } },
    { "id": "o7", "note": "propertyNames", "schema": { "type": "object", "propertyNames": { "maxLength": 1 } }, "instance": { "ab": 1 } },
    { "id": "o8", "note": "required with no type, a string", "schema": { "required": ["a"] }, "instance": "str" },
    { "id": "o9", "note": "property type string, a null value", "schema": { "type": "object", "properties": { "a": { "type": "string" } } }, "instance": { "a": null } },
    { "id": "o10", "note": "properties with no type, a number", "schema": { "properties": { "a": { "type": "string" } } }, "instance": 5 },
    { "id": "o11", "note": "additionalProperties false, a key a pattern also matches and properties names", "schema": { "type": "object", "properties": { "xa": { "type": "string" } }, "patternProperties": { "^x": { "minLength": 3 } } }, "instance": { "xa": "s" } },
    { "id": "o12", "note": "duplicate keys in the text, the last one valid", "schema": { "type": "object", "properties": { "a": { "type": "string" } } }, "instance_text": "{\"a\": 1, \"a\": \"x\"}" },
    { "id": "o13", "note": "duplicate keys in the text, the first one valid", "schema": { "type": "object", "properties": { "a": { "type": "string" } } }, "instance_text": "{\"a\": \"x\", \"a\": 1}" },

    { "id": "a1", "note": "items a schema", "schema": { "items": { "type": "string" } }, "instance": [1] },
    { "id": "a2", "note": "items an array (a tuple before 2020-12)", "schema": { "items": [{ "type": "string" }] }, "instance": [1] },
    { "id": "a3", "note": "items an array with additionalItems false", "schema": { "items": [{ "type": "string" }], "additionalItems": false }, "instance": ["a", 1] },
    { "id": "a4", "note": "prefixItems", "schema": { "prefixItems": [{ "type": "string" }] }, "instance": [1] },
    { "id": "a5", "note": "prefixItems with items false", "schema": { "prefixItems": [{ "type": "string" }], "items": false }, "instance": ["a", 1] },
    { "id": "a6", "note": "prefixItems with items a schema, the rest wrong", "schema": { "prefixItems": [{ "type": "string" }], "items": { "type": "integer" } }, "instance": ["a", "b"] },
    { "id": "a7", "note": "contains", "schema": { "contains": { "type": "string" } }, "instance": [1] },
    { "id": "a8", "note": "minItems", "schema": { "minItems": 1 }, "instance": [] },
    { "id": "a9", "note": "items string, a null element", "schema": { "type": "array", "items": { "type": "string" } }, "instance": ["a", null] },
    { "id": "a10", "note": "items an array, a shorter array", "schema": { "items": [{ "type": "string" }, { "type": "integer" }] }, "instance": ["a"] },
    { "id": "a11", "note": "prefixItems with items false, the first element given as items' array form too", "schema": { "items": [{ "type": "string" }], "prefixItems": [{ "type": "integer" }] }, "instance": [1] },

    { "id": "c1", "note": "allOf of two types", "schema": { "allOf": [{ "type": "string" }, { "type": "number" }] }, "instance": "a" },
    { "id": "c2", "note": "anyOf, neither", "schema": { "anyOf": [{ "type": "string" }, { "type": "number" }] }, "instance": true },
    { "id": "c3", "note": "oneOf, both", "schema": { "oneOf": [{ "type": "integer" }, { "type": "number" }] }, "instance": 1 },
    { "id": "c4", "note": "not", "schema": { "not": { "type": "string" } }, "instance": "a" },
    { "id": "c5", "note": "allOf of closed objects", "schema": { "allOf": [{ "type": "object", "properties": { "a": {} }, "additionalProperties": false }, { "type": "object", "properties": { "b": {} } }] }, "instance": { "a": 1, "b": 2 } },

    { "id": "i1", "note": "if/then", "schema": { "if": { "type": "string" }, "then": { "minLength": 2 } }, "instance": "a" },
    { "id": "i2", "note": "if/then/else, else fails", "schema": { "if": { "type": "string" }, "then": { "minLength": 2 }, "else": { "type": "integer" } }, "instance": 1.5 },

    { "id": "r1", "note": "$ref to definitions", "schema": { "definitions": { "s": { "type": "string" } }, "$ref": "#/definitions/s" }, "instance": 1 },
    { "id": "r2", "note": "$ref to $defs", "schema": { "$defs": { "s": { "type": "string" } }, "$ref": "#/$defs/s" }, "instance": 1 },
    { "id": "r3", "note": "$ref beside a sibling keyword at the root", "schema": { "definitions": { "s": { "type": "string" } }, "$ref": "#/definitions/s", "maxLength": 1 }, "instance": "ab" },
    { "id": "r4", "note": "$ref beside a sibling keyword in a property", "schema": { "definitions": { "s": { "type": "string" } }, "properties": { "a": { "$ref": "#/definitions/s", "maxLength": 1 } } }, "instance": { "a": "ab" } },
    { "id": "r5", "note": "recursion through #", "schema": { "type": "object", "properties": { "c": { "$ref": "#" } } }, "instance": { "c": { "c": 1 } } },
    { "id": "r6", "note": "$ref by an embedded $id", "schema": { "$defs": { "s": { "$id": "http://x.test/s", "type": "string" } }, "$ref": "http://x.test/s" }, "instance": 1 },
    { "id": "r7", "note": "$ref to an $anchor", "schema": { "$defs": { "s": { "$anchor": "S", "type": "string" } }, "$ref": "#S" }, "instance": 1 },
    { "id": "r8", "note": "$ref to a remote document (a closed port)", "schema": { "$ref": "http://127.0.0.1:9/nothing.json" }, "instance": 1 },
    { "id": "r9", "note": "$ref to a missing pointer", "schema": { "$ref": "#/definitions/nope" }, "instance": 1 },
    { "id": "r10", "note": "$ref to an integer beside a sibling type string", "schema": { "definitions": { "i": { "type": "integer" } }, "$ref": "#/definitions/i", "type": "string" }, "instance": 1 },
    { "id": "r11", "note": "$ref by the old draft's id", "schema": { "definitions": { "s": { "id": "#S", "type": "string" } }, "properties": { "a": { "$ref": "#S" } } }, "instance": { "a": 1 } },
    { "id": "r12", "note": "$ref to the meta-schema of draft 7", "schema": { "$ref": "http://json-schema.org/draft-07/schema#" }, "instance": 1 },
    { "id": "r13", "note": "$recursiveRef", "schema": { "$recursiveAnchor": true, "type": "object", "properties": { "c": { "$recursiveRef": "#" } } }, "instance": { "c": 1 } },
    { "id": "r14", "note": "$dynamicRef", "schema": { "$dynamicAnchor": "n", "type": "object", "properties": { "c": { "$dynamicRef": "#n" } } }, "instance": { "c": 1 } },

    { "id": "p1", "note": "dependentRequired", "schema": { "dependentRequired": { "a": ["b"] } }, "instance": { "a": 1 } },
    { "id": "p2", "note": "dependentSchemas", "schema": { "dependentSchemas": { "a": { "required": ["b"] } } }, "instance": { "a": 1 } },
    { "id": "p3", "note": "dependencies", "schema": { "dependencies": { "a": ["b"] } }, "instance": { "a": 1 } },
    { "id": "p4", "note": "unevaluatedProperties false", "schema": { "unevaluatedProperties": false, "properties": { "a": {} } }, "instance": { "a": 1, "b": 2 } },
    { "id": "p5", "note": "unevaluatedItems false", "schema": { "unevaluatedItems": false, "prefixItems": [{}] }, "instance": [1, 2] },
    { "id": "p6", "note": "minProperties", "schema": { "minProperties": 1 }, "instance": {} },

    { "id": "b1", "note": "the schema false", "schema": false, "instance": 1 },
    { "id": "b2", "note": "a property schema false", "schema": { "properties": { "a": false } }, "instance": { "a": 1 } },
    { "id": "b3", "note": "the schema true", "schema": true, "instance": 1 },
    { "id": "b4", "note": "items false", "schema": { "items": false }, "instance": [1] },

    { "id": "m1", "note": "format email", "schema": { "type": "string", "format": "email" }, "instance": "nope" },
    { "id": "m2", "note": "OpenAPI's nullable", "schema": { "type": "string", "nullable": true }, "instance": null },
    { "id": "m3", "note": "a misspelled type name", "schema": { "type": "strin" }, "instance": "a" },
    { "id": "m4", "note": "an unknown keyword", "schema": { "foo": 1 }, "instance": 1 },
    { "id": "m5", "note": "a schema that is not JSON", "schema_text": "{\"type\": ", "instance": 1 },
    { "id": "m6", "note": "minimum, a string", "schema": { "minimum": 5 }, "instance": "a" },
    { "id": "m7", "note": "draft 4's boolean exclusiveMaximum", "schema": { "maximum": 5, "exclusiveMaximum": true }, "instance": 5 },
    { "id": "m8", "note": "exclusiveMaximum a number", "schema": { "exclusiveMaximum": 5 }, "instance": 5 },
    { "id": "m9", "note": "a schema that is an array", "schema": [{ "type": "string" }], "instance": 1 },
    { "id": "m10", "note": "a schema that is a string", "schema": "string", "instance": 1 },
    { "id": "m11", "note": "type an empty list", "schema": { "type": [] }, "instance": 1 },
    { "id": "m12", "note": "required not a list", "schema": { "required": "a" }, "instance": {} },
    { "id": "m13", "note": "pattern, an invalid regular expression", "schema": { "type": "string", "pattern": "([" }, "instance": "a" },
    { "id": "m14", "note": "contentMediaType JSON, a string that is not JSON", "schema": { "type": "string", "contentMediaType": "application/json" }, "instance": "{" },
    { "id": "m15", "note": "enum empty", "schema": { "enum": [] }, "instance": 1 }
  ]
}
