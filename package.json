{
  "name": "porg",
  "version": "0.0.0",
  "private": true,
  "description": "Import SQL files as fully typed queries. A TypeScript content mapper plus a runtime loader.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "porg": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./vite": "./src/vite.ts",
    "./esbuild": "./src/esbuild.ts",
    "./webpack-loader": "./src/webpack-loader.ts",
    "./jest": "./src/jest.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "build": "nub scripts/build.ts",
    "typecheck": "tsc --noEmit --runExternalCode",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.1.0-dev.20260918.1"
  },
  "dependencies": {
    "tinyglobby": "^0.2.17"
  }
}
