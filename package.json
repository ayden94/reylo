{
  "name": "lando",
  "version": "0.0.0",
  "description": "Import SQL files as fully typed queries. A TypeScript content mapper plus a runtime loader.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./mapper": "./src/mapper.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --runExternalCode",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.1.0-dev.20260918.1"
  }
}
