{
  "name": "lando",
  "version": "0.0.0",
  "description": "A type-safe ORM and schema kit for Postgres.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.1",
  "exports": {
    ".": "./src/orm/index.ts",
    "./pg": "./src/pg/index.ts"
  },
  "imports": {
    "#schema": "./src/schema/index.ts",
    "#schema/*": "./src/schema/*.ts",
    "#orm": "./src/orm/index.ts",
    "#orm/*": "./src/orm/*.ts",
    "#cli": "./src/cli/index.ts",
    "#cli/*": "./src/cli/*.ts",
    "#prisma": "./src/prisma/index.ts",
    "#prisma/*": "./src/prisma/*.ts",
    "#config": "./src/config/index.ts",
    "#config/*": "./src/config/*.ts",
    "#pg": "./src/pg/index.ts",
    "#pg/*": "./src/pg/*.ts",
    "#test/*": "./tests/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mrleebo/prisma-ast": "^0.15.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "prettier": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
