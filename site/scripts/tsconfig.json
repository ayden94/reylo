{
  // The capture script runs on Node (nub), outside the Next.js app, and imports the loader's own
  // source with its .ts extensions, as the repository's tsconfig does. The site's tsconfig leaves
  // scripts/ out; check them with `nubx tsc -p scripts`.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
