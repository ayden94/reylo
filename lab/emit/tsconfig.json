{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext"],
    "types": [],
    "strict": true,
    "outDir": "dist",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  },
  "contentMappers": [{ "package": "lando", "extensions": [".sql"] }],
  "include": ["*.ts", "*.sql"]
}
