{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": [
      "esnext"
    ],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "contentMappers": [
    {
      "package": "lando",
      "extensions": [
        ".sql"
      ],
      "options": {
        "dialect": "postgres"
      }
    }
  ],
  "include": [
    "."
  ],
  "exclude": [
    "untyped",
    "run.ts",
    "setup.sql",
    "node_modules"
  ]
}
