{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "contentMappers": [
    { "package": "porg", "extensions": [".sql"] }
  ],
  "include": ["."],
  "exclude": ["run.ts", "node_modules"]
}
