    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.1.0-dev.20260918.1"
  }
}
