// Zed: the project's TypeScript 7.1 language server with content mappers on.
// Needs the "TypeScript Language Server" extension (id `tsgo`, by Zed Industries),
// which registers the `typescript-ls` server; `binary` runs this project's
// typescript instead of the one the extension downloads (7.0, no content mappers).
{
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
    }
  },
  "lsp": {
    "typescript-ls": {
      "binary": {
        "path": "node_modules/typescript/bin/tsc",
        "arguments": ["--lsp", "--stdio"]
      },
      "initialization_options": {
        "runExternalCode": true
      }
    }
  }
}
